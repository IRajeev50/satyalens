# Database. Leave unset for zero-setup SQLite at ./satyalens.db
# DATABASE_URL=  (leave commented for zero-setup SQLite at ./satyalens.db)
# Real Google Fact Check Tools API key: https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=
# LLM reasoning: set both LLM_API_KEY and SEARCH_API_KEY to verify arbitrary claims
# (search open-web/primary sources, then adjudicate with citations). Provider defaults
# to anthropic; model defaults to claude-sonnet-5.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Web search for evidence. Provider: tavily (default) or brave.
# Tavily: https://tavily.com  ·  Brave: https://brave.com/search/api
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
# Comma-separated browser origins allowed to call the API in local/dev deployments.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional OCR API seam. Local Tesseract is used when installed; no OCR result is fabricated.
OCR_API_KEY=
OCR_PROVIDER=local_tesseract
MAX_UPLOAD_MB=10

# Image-forensics vendor seams. Local metadata/perceptual hashing always run.
C2PA_CLI_PATH=
REVERSE_IMAGE_API_KEY=
REVERSE_IMAGE_PROVIDER=
FORENSICS_API_KEY=
FORENSICS_PROVIDER=

# WhatsApp Cloud API intake seam. Required to accept/verify real Meta webhooks.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Translation seam for original/translated dual display. No translation is fabricated when absent.
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER=
